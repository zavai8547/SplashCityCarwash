@model SplashCityCarwash.Models.Branch
@{
    ViewData["Title"] = "Edit Branch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/Branch/Index"
       class="btn btn-outline-secondary
              rounded-pill px-3">
        Back
    </a>
    <h4 class="fw-bold mb-0">Edit Branch</h4>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm"
             style="border-radius:20px;
                    overflow:hidden;">
            <div class="card-header border-0 p-4"
                 style="background:linear-gradient(
                            135deg,#007A3D,#005C2E);">
                <h5 class="text-white fw-bold mb-0">
                    @Model.Name
                </h5>
                <small style="color:rgba(255,255,255,0.75);">
                    Edit branch details
                </small>
            </div>
            <div class="card-body p-4">
                <form method="post"
                      action="/Branch/Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="branchID"
                           value="@Model.BranchID" />

                    <div class="mb-3">
                        <label class="form-label
                                      fw-semibold">
                            Branch Name *
                        </label>
                        <input type="text"
                               name="name"
                               class="form-control"
                               style="border-radius:10px;"
                               value="@Model.Name"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label
                                      fw-semibold">
                            Location / Address
                        </label>
                        <input type="text"
                               name="location"
                               class="form-control"
                               style="border-radius:10px;"
                               value="@Model.Location" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label
                                      fw-semibold">
                            Branch Phone
                        </label>
                        <input type="text"
                               name="phone"
                               class="form-control"
                               style="border-radius:10px;"
                               value="@Model.Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label
                                      fw-semibold">
                            Manager Name
                        </label>
                        <input type="text"
                               name="managerName"
                               class="form-control"
                               style="border-radius:10px;"
                               value="@Model.ManagerName" />
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="isActive"
                                   value="true"
                                   id="isActive"
                            @(Model.IsActive
                                ? "checked" : "") />
                            <label class="form-check-label
                                          fw-semibold"
                                   for="isActive">
                                Branch is Active
                            </label>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <button type="submit"
                                class="btn btn-lg
                                       flex-grow-1
                                       fw-bold"
                                style="background:#007A3D;
                                       color:white;
                                       border-radius:12px;">
                            Save Changes
                        </button>
                        <a href="/Branch/Index"
                           class="btn btn-lg
                                  btn-outline-secondary
                                  rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>