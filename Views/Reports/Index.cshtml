<!-- WEEKLY PERFORMANCE -->
<div class="card border-0 shadow-sm mb-4"
     style="border-radius:16px;overflow:hidden;">
    <div class="card-header border-0 p-3"
         style="background:linear-gradient(
                    135deg,#1a1a2e,#16213e);">
        <div class="d-flex justify-content-between
                     align-items-center">
            <div>
                <h6 class="text-white fw-bold mb-0">
                    📅 This Week
                </h6>
                <small style="color:rgba(255,255,255,0.6);">
                    @ViewBag.WeekStart —
                    @ViewBag.WeekEnd
                </small>
            </div>
            <div class="text-end">
                <div style="font-size:1.4rem;
                             font-weight:800;
                             color:#4ade80;">
                    KES @thisWeek.ToString("N0")
                </div>
                <small style="color:@(weekChange >= 0
                    ? "#4ade80" : "#f87171");">
                    @(weekChange >= 0 ? "▲" : "▼")
                    @Math.Abs(weekChange).ToString("N1")%
                    vs last week
                    (KES @lastWeek.ToString("N0"))
                </small>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#f8fafc;">
                <tr>
                    @foreach (var h in new[]
                    {
                        "Day","Washes","Carwash",
                        "Shop","Total",
                        "Expenses","Net Profit"
                    })
                    {
                        <th style="padding:10px 14px;
                                   font-size:0.8rem;
                                   color:#6b7280;
                                   font-weight:600;
                                   border:none;
                                   white-space:nowrap;">
                            @h
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    var weekly = ViewBag.WeeklyData
                        as IEnumerable<dynamic>;
                    decimal wTotalCar = 0,
                            wTotalShop = 0,
                            wTotalAll = 0,
                            wTotalExp = 0,
                            wTotalProfit = 0;
                    int wTotalWashes = 0;
                }
                @if (weekly != null)
                {
                    foreach (var w in weekly)
                    {
                        bool isToday =
                            (bool)w.isToday;
                        decimal wProfit =
                            (decimal)w.profit;
                        wTotalCar +=
                            (decimal)w.carwash;
                        wTotalShop +=
                            (decimal)w.shop;
                        wTotalAll +=
                            (decimal)w.total;
                        wTotalExp +=
                            (decimal)w.expenses;
                        wTotalProfit +=
                            (decimal)w.profit;
                        wTotalWashes +=
                            (int)w.washes;
                        <tr style="@(isToday
                            ? "background:#f0fdf4;font-weight:600;"
                            : "")">
                            <td style="padding:10px 14px;
                                       font-size:0.88rem;">
                                @w.day
                                @if (isToday)
                                {
                                    <span style="font-size:0.7rem;
                                                  background:#007A3D;
                                                  color:white;
                                                  padding:1px 6px;
                                                  border-radius:10px;
                                                  margin-left:4px;">
                                        TODAY
                                    </span>
                                }
                            </td>
                            <td style="padding:10px 14px;
                                       font-size:0.85rem;">
                                @w.washes
                            </td>
                            <td style="padding:10px 14px;
                                       font-size:0.85rem;">
                                KES @(((decimal)w.carwash).ToString("N0"))
                            </td>
                            <td style="padding:10px 14px;
                                       font-size:0.85rem;">
                                KES @(((decimal)w.shop).ToString("N0"))
                            </td>
                            <td style="padding:10px 14px;
                                       font-weight:700;
                                       font-size:0.88rem;">
                                KES @(((decimal)w.total).ToString("N0"))
                            </td>
                            <td style="padding:10px 14px;
                                       font-size:0.85rem;
                                       color:#dc2626;">
                                KES @(((decimal)w.expenses).ToString("N0"))
                            </td>
                            <td style="padding:10px 14px;
                                       font-weight:700;
                                       color:@(wProfit >= 0
                                           ? "#16a34a"
                                           : "#dc2626");">
                                KES @wProfit.ToString("N0")
                            </td>
                        </tr>
                    }
                    <tr style="background:#f8fafc;
                                font-weight:700;">
                        <td style="padding:10px 14px;">
                            WEEK TOTAL
                        </td>
                        <td style="padding:10px 14px;">
                            @wTotalWashes
                        </td>
                        <td style="padding:10px 14px;">
                            KES @wTotalCar.ToString("N0")
                        </td>
                        <td style="padding:10px 14px;">
                            KES @wTotalShop.ToString("N0")
                        </td>
                        <td style="padding:10px 14px;
                                   color:#007A3D;">
                            KES @wTotalAll.ToString("N0")
                        </td>
                        <td style="padding:10px 14px;
                                   color:#dc2626;">
                            KES @wTotalExp.ToString("N0")
                        </td>
                        <td style="padding:10px 14px;
                                   color:@(wTotalProfit >= 0
                                       ? "#16a34a"
                                       : "#dc2626");">
                            KES @wTotalProfit.ToString("N0")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- BRANCH COMPARISON -->
@{
    var branchComp = ViewBag.BranchComparison
        as IEnumerable<dynamic>;
}
@if (branchComp != null && branchComp.Count() > 1)
{
    <div class="card border-0 shadow-sm mb-4"
         style="border-radius:16px;overflow:hidden;">
        <div class="card-header border-0 p-3"
             style="background:#007A3D;">
            <h6 class="text-white fw-bold mb-0">
                🏪 Branch Comparison —
                @ViewBag.SelectedMonthName
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background:#f8fafc;">
                    <tr>
                        @foreach (var h in new[]
                        {
                            "Branch","Washes",
                            "Carwash Revenue",
                            "Shop Revenue",
                            "Total Revenue",
                            "Expenses","Net Profit"
                        })
                        {
                            <th style="padding:11px 14px;
                                       font-size:0.8rem;
                                       color:#6b7280;
                                       font-weight:600;
                                       border:none;">
                                @h
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        decimal maxRevenue =
                            branchComp.Max(b =>
                                (decimal)b.Total);
                    }
                    @foreach (var b in branchComp
                        .OrderByDescending(b =>
                            (decimal)b.Total))
                    {
                        decimal bTotal =
                            (decimal)b.Total;
                        decimal bProfit =
                            (decimal)b.Profit;
                        decimal pct = maxRevenue > 0
                            ? (bTotal / maxRevenue
                                * 100) : 0;

                        <tr>
                            <td style="padding:12px 14px;
                                       font-weight:700;">
                                @b.Name
                                <div style="background:
                                             #e2e8f0;
                                             border-radius:
                                             20px;
                                             height:6px;
                                             margin-top:6px;
                                             overflow:hidden;">
                                    <div style="width:@pct.ToString("F1")%;
                                                 background:
                                                 #007A3D;
                                                 height:100%;
                                                 border-radius:
                                                 20px;">
                                    </div>
                                </div>
                            </td>
                            <td style="padding:12px 14px;">
                                @b.Washes
                            </td>
                            <td style="padding:12px 14px;">
                                KES @(((decimal)b.CarwashRevenue).ToString("N0"))
                            </td>
                            <td style="padding:12px 14px;">
                                KES @(((decimal)b.ShopRevenue).ToString("N0"))
                            </td>
                            <td style="padding:12px 14px;
                                       font-weight:800;
                                       color:#007A3D;">
                                KES @bTotal.ToString("N0")
                            </td>
                            <td style="padding:12px 14px;
                                       color:#dc2626;">
                                KES @(((decimal)b.Expenses).ToString("N0"))
                            </td>
                            <td style="padding:12px 14px;
                                       font-weight:700;
                                       color:@(bProfit >= 0
                                           ? "#16a34a"
                                           : "#dc2626");">
                                KES @bProfit.ToString("N0")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- MONTHLY BREAKDOWN -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border-radius:16px;">
            <div class="card-header bg-white border-0
                         pt-3 pb-0">
                <h6 class="fw-bold mb-0">
                    🚗 Carwash —
                    @ViewBag.SelectedMonthName
                </h6>
            </div>
            <div class="card-body">
                @{
                    void Row(string label, string val,
                        string color = "#374151")
                    {
                        <div style="display:flex;
                                     justify-content:
                                         space-between;
                                     padding:8px 0;
                                     border-bottom:
                                         1px solid #f1f5f9;
                                     font-size:0.88rem;">
                            <span style="color:#888;">
                                @label
                            </span>
                            <strong style="color:@color;">
                                @val
                            </strong>
                        </div>
                    }
                }
                @{ Row("Revenue",
                    "KES " + ((decimal)(ViewBag
                        .CarwashRevenueMonth ?? 0m))
                        .ToString("N0"), "#16a34a"); }
                @{ Row("Expenses",
                    "KES " + ((decimal)(ViewBag
                        .ExpensesMonth ?? 0m))
                        .ToString("N0"), "#dc2626"); }
                @{ Row("Washes Done",
                    (ViewBag.WashesMonth ?? 0)
                        .ToString()); }
                @{ Row("Year Revenue",
                    "KES " + ((decimal)(ViewBag
                        .CarwashRevenueYear ?? 0m))
                        .ToString("N0")); }
                @{
                    decimal cp = ViewBag
                        .CarwashProfitMonth ?? 0m;
                    <div style="background:@(cp >= 0
                        ? "#f0fdf4" : "#fef2f2");
                         border-radius:10px;
                         padding:12px;
                         margin-top:12px;
                         display:flex;
                         justify-content:space-between;">
                        <span class="fw-bold">
                            Net Profit
                        </span>
                        <strong style="color:@(cp >= 0
                            ? "#16a34a" : "#dc2626");
                             font-size:1.1rem;">
                            @(cp >= 0 ? "+" : "")KES
                            @cp.ToString("N0")
                        </strong>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border-radius:16px;">
            <div class="card-header bg-white border-0
                         pt-3 pb-0">
                <h6 class="fw-bold mb-0">
                    🛒 Shop — @ViewBag.SelectedMonthName
                </h6>
            </div>
            <div class="card-body">
                @{ Row("Revenue",
                    "KES " + ((decimal)(ViewBag
                        .ShopRevenueMonth ?? 0m))
                        .ToString("N0"), "#16a34a"); }
                @{ Row("Cost of Goods",
                    "KES " + ((decimal)(ViewBag
                        .ShopCostMonth ?? 0m))
                        .ToString("N0"), "#dc2626"); }
                @{ Row("Year Revenue",
                    "KES " + ((decimal)(ViewBag
                        .ShopRevenueYear ?? 0m))
                        .ToString("N0")); }
                @{
                    decimal sp = ViewBag
                        .ShopProfitMonth ?? 0m;
                    <div style="background:@(sp >= 0
                        ? "#f0fdf4" : "#fef2f2");
                         border-radius:10px;
                         padding:12px;
                         margin-top:12px;
                         display:flex;
                         justify-content:space-between;">
                        <span class="fw-bold">
                            Net Profit
                        </span>
                        <strong style="color:@(sp >= 0
                            ? "#16a34a" : "#dc2626");
                             font-size:1.1rem;">
                            @(sp >= 0 ? "+" : "")KES
                            @sp.ToString("N0")
                        </strong>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border-radius:16px;
                    border:2px solid #1565C0 !important;">
            <div class="card-header border-0 pt-3 pb-0"
                 style="background:#f0f7ff;">
                <h6 class="fw-bold mb-0"
                    style="color:#1565C0;">
                    🏆 Combined —
                    @ViewBag.SelectedMonthName
                </h6>
            </div>
            <div class="card-body"
                 style="background:#f0f7ff;">
                @{ Row("Total Revenue",
                    "KES " + ((decimal)(ViewBag
                        .TotalRevenueMonth ?? 0m))
                        .ToString("N0"), "#16a34a"); }
                @{ Row("Total Costs",
                    "KES " + ((decimal)(ViewBag
                        .TotalCostsMonth ?? 0m))
                        .ToString("N0"), "#dc2626"); }
                @{ Row("Year Revenue",
                    "KES " + ((decimal)(ViewBag
                        .TotalRevenueYear ?? 0m))
                        .ToString("N0")); }
                @{
                    decimal tp = ViewBag
                        .TotalProfitMonth ?? 0m;
                    <div style="background:@(tp >= 0
                        ? "#dcfce7" : "#fef2f2");
                         border-radius:10px;
                         padding:12px;
                         margin-top:12px;
                         display:flex;
                         justify-content:space-between;">
                        <span class="fw-bold"
                              style="color:#1565C0;">
                            NET PROFIT
                        </span>
                        <strong style="color:@(tp >= 0
                            ? "#16a34a" : "#dc2626");
                             font-size:1.3rem;">
                            @(tp >= 0 ? "+" : "")KES
                            @tp.ToString("N0")
                        </strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 6 MONTH TREND -->
