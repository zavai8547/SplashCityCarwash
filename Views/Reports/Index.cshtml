                                       font-size:0.85rem;">
                                KES @(((decimal)m.carwashRevenue).ToString("N0"))
                            </td>
                            <td style="padding:11px 14px;
                                       font-size:0.85rem;">
                                KES @(((decimal)m.shopRevenue).ToString("N0"))
                            </td>
                            <td style="padding:11px 14px;
                                       font-weight:700;">
                                KES @(((decimal)m.totalRevenue).ToString("N0"))
                            </td>
                            <td style="padding:11px 14px;
                                       color:#dc2626;
                                       font-size:0.85rem;">
                                KES @(((decimal)m.expenses).ToString("N0"))
                            </td>
                            <td style="padding:11px 14px;
                                       font-weight:700;
                                       color:@(mp >= 0
                                           ? "#16a34a"
                                           : "#dc2626");">
                                @(mp >= 0 ? "+" : "")KES
                                @mp.ToString("N0")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SERVICE POPULARITY + PAYMENT METHODS -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm"
             style="border-radius:16px;overflow:hidden;">
            <div class="card-header bg-white
                         fw-semibold border-0 pt-3">
                🏆 Service Popularity —
                @ViewBag.SelectedMonthName
            </div>
            <div class="table-responsive">
                @if (ViewBag.ServiceStats != null &&
                     ((IEnumerable<dynamic>)
                         ViewBag.ServiceStats).Any())
                {
                    <table class="table
                                  table-hover mb-0">
                        <thead style="background:#f8fafc;">
                            <tr>
                                <th style="padding:10px 14px;
                                           font-size:0.8rem;
                                           color:#6b7280;
                                           border:none;">
                                    Service
                                </th>
                                <th style="padding:10px 14px;
                                           font-size:0.8rem;
                                           color:#6b7280;
                                           border:none;">
                                    Times Used
                                </th>
                                <th style="padding:10px 14px;
                                           font-size:0.8rem;
                                           color:#6b7280;
                                           border:none;">
                                    Revenue
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (dynamic s in
                                ViewBag.ServiceStats)
                            {
                                <tr>
                                    <td style="padding:
                                               10px 14px;
                                               font-size:
                                               0.85rem;">
                                        @s.ServiceName
                                    </td>
                                    <td style="padding:
                                               10px 14px;">
                                        <span style="padding:2px 8px;
                                                      border-radius:20px;
                                                      font-size:0.75rem;
                                                      font-weight:700;
                                                      background:#dbeafe;
                                                      color:#2563eb;">
                                            @s.TimesUsed
                                        </span>
                                    </td>
                                    <td style="padding:
                                               10px 14px;
                                               font-weight:700;
                                               color:#007A3D;">
                                        KES @(((decimal)s.Revenue).ToString("N0"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center
                                text-muted py-4">
                        No data for this month
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm"
             style="border-radius:16px;overflow:hidden;">
            <div class="card-header bg-white
                         fw-semibold border-0 pt-3">
                💳 Payment Methods —
                @ViewBag.SelectedMonthName
            </div>
            <div class="table-responsive">
                @if (ViewBag.PaymentStats != null &&
                     ((IEnumerable<dynamic>)
                         ViewBag.PaymentStats).Any())
                {
                    <table class="table
                                  table-hover mb-0">
                        <thead style="background:#f8fafc;">
                            <tr>
                                @foreach (var h in new[]
                                {
                                    "Method",
                                    "Transactions",
                                    "Total"
                                })
                                {
                                    <th style="padding:
                                               10px 14px;
                                               font-size:
                                               0.8rem;
                                               color:#6b7280;
                                               border:none;">
                                        @h
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (dynamic pm in
                                ViewBag.PaymentStats)
                            {
                                string method =
                                    pm.Method.ToString();
                                string bg =
                                    method == "Cash"
                                    ? "#dcfce7"
                                    : method == "MPesa"
                                    ? "#fef3c7"
                                    : "#dbeafe";
                                string color =
                                    method == "Cash"
                                    ? "#16a34a"
                                    : method == "MPesa"
                                    ? "#92400e"
                                    : "#2563eb";
                                <tr>
                                    <td style="padding:
                                               10px 14px;">
                                        <span style="padding:3px 10px;
                                                      border-radius:20px;
                                                      font-size:0.75rem;
                                                      font-weight:700;
                                                      background:@bg;
                                                      color:@color;">
                                            @method
                                        </span>
                                    </td>
                                    <td style="padding:
                                               10px 14px;
                                               font-size:
                                               0.85rem;">
                                        @pm.Count
                                    </td>
                                    <td style="padding:
                                               10px 14px;
                                               font-weight:700;">
                                        KES @(((decimal)pm.Total).ToString("N0"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center
                                text-muted py-4">
                        No data for this month
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- TOP CUSTOMERS -->
<div class="card border-0 shadow-sm"
     style="border-radius:16px;overflow:hidden;">
    <div class="card-header bg-white fw-semibold
                 border-0 pt-3">
        ⭐ Top 5 Customers — All Time
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#f8fafc;">
                <tr>
                    @foreach (var h in new[]
                    {
                        "#","Customer","Phone",
                        "Total Visits","Total Spent"
                    })
                    {
                        <th style="padding:10px 14px;
                                   font-size:0.8rem;
                                   color:#6b7280;
                                   font-weight:600;
                                   border:none;">
                            @h
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.TopCustomers != null)
                {
                    int rank = 1;
                    foreach (dynamic c in
                        ViewBag.TopCustomers)
                    {
                        string rankBg =
                            rank == 1 ? "#fef3c7"
                            : rank == 2 ? "#f1f5f9"
                            : "#fafafa";
                        string rankColor =
                            rank == 1 ? "#92400e"
                            : "#6b7280";
                        <tr>
                            <td style="padding:
                                       12px 14px;">
                                <span style="width:28px;
                                              height:28px;
                                              border-radius:50%;
                                              display:inline-flex;
                                              align-items:center;
                                              justify-content:center;
                                              font-size:0.8rem;
                                              font-weight:800;
                                              background:@rankBg;
                                              color:@rankColor;">
                                    @rank
                                </span>
                            </td>
                            <td style="padding:
                                       12px 14px;
                                       font-weight:600;
                                       font-size:0.88rem;">
                                @c.FullName
                            </td>
                            <td style="padding:
                                       12px 14px;
                                       font-size:0.85rem;
                                       font-family:monospace;">
                                @c.Phone
                            </td>
                            <td style="padding:
                                       12px 14px;
                                       font-size:0.85rem;">
                                @c.TotalVisits
                            </td>
                            <td style="padding:
                                       12px 14px;
                                       font-weight:700;
                                       color:#16a34a;">
                                KES @(((decimal)c.TotalSpent).ToString("N0"))
                            </td>
                        </tr>
                        rank++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
