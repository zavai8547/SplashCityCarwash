@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? selectedBranch = ViewBag.SelectedBranch;
    decimal weekChange = ViewBag.WeekChange ?? 0m;
    decimal thisWeek = ViewBag.ThisWeekTotal ?? 0m;
    decimal lastWeek = ViewBag.LastWeekTotal ?? 0m;
}

<div class="d-flex justify-content-between
            align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            Reports &amp; Analytics
        </h4>
        <small class="text-muted">
            @ViewBag.SelectedMonthName
            @if (selectedBranch != null &&
                 ViewBag.Branches != null)
            {
                var br = ((IEnumerable<dynamic>)
                    ViewBag.Branches)
                    .FirstOrDefault(b =>
                        b.BranchID == selectedBranch);
                if (br != null)
                {
                    <span class="badge ms-2"
                          style="background:#007A3D;">
                        @br.Name
                    </span>
                }
            }
        </small>
    </div>
</div>

<!-- FILTERS -->
<div class="card border-0 shadow-sm p-3 mb-4"
     style="border-radius:16px;">
    <form method="get" action="/Reports/Index">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small
                               text-muted fw-semibold">
                    Month
                </label>
                <select name="month"
                        class="form-select"
                        style="border-radius:10px;">
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (m == ViewBag.SelectedMonth)
                        {
                            <option value="@m" selected>
                                @(new DateTime(2026, m, 1)
                                    .ToString("MMMM"))
                            </option>
                        }
                        else
                        {
                            <option value="@m">
                                @(new DateTime(2026, m, 1)
                                    .ToString("MMMM"))
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small
                               text-muted fw-semibold">
                    Year
                </label>
                <select name="year"
                        class="form-select"
                        style="border-radius:10px;">
                    @for (int y = 2025;
                          y <= DateTime.Now.Year + 1;
                          y++)
                    {
                        if (y == ViewBag.SelectedYear)
                        {
                            <option value="@y" selected>
                                @y
                            </option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small
                               text-muted fw-semibold">
                    Branch
                </label>
                <select name="branchID"
                        class="form-select"
                        style="border-radius:10px;">
                    <option value="">
                        All Branches Combined
                    </option>
                    @if (ViewBag.Branches != null)
                    {
                        foreach (var b in
                            ViewBag.Branches)
                        {
                            if (b.BranchID ==
                                selectedBranch)
                            {
                                <option
                                    value="@b.BranchID"
                                    selected>
                                    @b.Name
                                </option>
                            }
                            else
                            {
                                <option
                                    value="@b.BranchID">
                                    @b.Name
                                </option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small
                               text-muted fw-semibold">
                    &nbsp;
                </label>
                <button type="submit"
                        class="btn w-100 fw-semibold"
                        style="background:#1a1a2e;
                               color:white;
                               border-radius:10px;">
                    View
                </button>
            </div>
            <div class="col-md-2">
                <label class="form-label small
                               text-muted fw-semibold">
                    &nbsp;
                </label>
                <a href="/Reports/Index"
                   class="btn btn-outline-secondary
                          w-100"
                   style="border-radius:10px;">
                    Reset
                </a>
            </div>
        </div>
    </form>
</div>

<!-- TODAY STATS -->
