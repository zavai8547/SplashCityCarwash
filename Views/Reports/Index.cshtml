            <div class="card-body">
                <p class="text-muted small mb-1">
                    Total Customers
                </p>
                <h5 class="fw-bold mb-0">
                    @(ViewBag.TotalCustomers ?? 0)
                </h5>
                <small class="text-muted">All time</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm"
             style="border-radius:14px;
                    border-left:4px solid
                        #ec4899 !important;">
            <div class="card-body">
                <p class="text-muted small mb-1">
